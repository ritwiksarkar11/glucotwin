digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.6, pad=0.3, bgcolor="white",
         label="GlucoTwin Ward — architecture (research prototype, synthetic data)", labelloc=t, fontsize=16];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#cbd5e1", fillcolor="#ffffff", penwidth=1.2, margin="0.14,0.07"];
  edge  [color="#64748b", arrowsize=0.7, fontname="Helvetica", fontsize=8.5, fontcolor="#475569"];

  subgraph cluster_in { label="1 · Hospital data"; style="rounded,filled"; fillcolor="#f8fafc"; color="#e2e8f0";
    his [label="Hospital information system\nFHIR R4 Bulk export\nEncounter · fingersticks · labs · orders\nMAR · diet/NPO · meal intake", fillcolor="#eff6ff", color="#bfdbfe"];
    cgm [label="CGM (when worn)\n5-min glucose", fillcolor="#ecfdf5", color="#a7f3d0"];
  }
  subgraph cluster_twin { label="2 · One twin per inpatient, updated hourly"; style="rounded,filled"; fillcolor="#f8fafc"; color="#e2e8f0";
    feat [label="Causal state\nwhat happened up to now\n+ orders already written\n(tonight's basal, fasting, steroids)"];
    risk [label="12-h risk of a low / severe high\nfingerstick mode · CGM mode\ncalibrated", fillcolor="#eff6ff", color="#bfdbfe"];
    traj [label="1-12 h glucose forecast\n80% range (conformal)", fillcolor="#eff6ff", color="#bfdbfe"];
    pk   [label="Pharmacology layer\ninsulin action profiles × patient's\ninsulin sensitivity (1700 rule)\nvalidated on counterfactuals", fillcolor="#f5f3ff", color="#ddd6fe"];
    rules [label="Bedside checks\nfasting · intake · steroid stop\nkidney injury · recent low", fillcolor="#fffbeb", color="#fde68a"];
  }
  subgraph cluster_out { label="3 · Four features"; style="rounded,filled"; fillcolor="#f8fafc"; color="#e2e8f0";
    f1 [label="1  Ward risk board", fillcolor="#0f766e", fontcolor="white", color="#0f766e"];
    f2 [label="2  Before you give insulin\n+ doctor what-if", fillcolor="#0f766e", fontcolor="white", color="#0f766e"];
    f3 [label="3  Smart monitoring\nextra check · suggest CGM", fillcolor="#0f766e", fontcolor="white", color="#0f766e"];
    f4 [label="4  Discharge handover\nnew diabetes · follow-up", fillcolor="#0f766e", fontcolor="white", color="#0f766e"];
  }
  store [label="Twin store (SQLite)\nsnapshots · decisions · checks\nfollow-ups · audit log", shape=cylinder, fillcolor="#f1f5f9"];
  staff [label="Nurse · doctor · educator\n(decide; twin never doses)", shape=box, fillcolor="#ffffff"];

  his -> feat; cgm -> feat;
  feat -> risk; feat -> traj; feat -> rules;
  risk -> f1; rules -> f1; risk -> f2; rules -> f2; traj -> pk; pk -> f2; traj -> f3; risk -> f3; his -> f4;
  f1 -> staff; f2 -> staff; f3 -> staff; f4 -> staff;
  staff -> store [label="decisions, bookings"]; f1 -> store [style=dashed];
}
